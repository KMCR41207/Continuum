{
  "name": "continuum-mani",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "selfhosted": "node scripts/selfhosted.mjs",
    "test:selfhosted-ui": "playwright test --config playwright.selfhosted.config.ts",
    "extension:build": "node apps/browser-extension/build.mjs",
    "test:extension": "node --test tests/extension/*.test.mjs",
    "api": "node --env-file-if-exists=.env.server server/api.ts",
    "mcp:http": "node --env-file-if-exists=.env.mcp server/http.ts",
    "worker": "node --env-file-if-exists=.env.server server/worker.ts",
    "mcp": "node server/mcp.ts",
    "cli": "node server/cli.ts",
    "test:connections-ui": "playwright test --config playwright.connections.config.ts",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "@supabase/supabase-js": "latest",
    "aos": "^2.3.4",
    "gsap": "^3.15.0",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "latest",
    "stripe": "^23.1.0",
    "three": "^0.187.0",
    "zod": "latest"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@electric-sql/pglite-pgvector": "^0.0.14",
    "@playwright/test": "latest",
    "@types/aos": "^3.0.8",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "latest",
    "prettier": "^3.9.10",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest"
  }
}
