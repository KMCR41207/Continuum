CONTINUUM_DATA_DIR=../../data
# A private JWT signing key is generated in data/sqlite if this is empty.
CONTINUUM_JWT_SECRET=
CONTINUUM_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
CONTINUUM_ALLOWED_HOSTS=127.0.0.1,localhost
CONTINUUM_EMBEDDING_PROVIDER=sentence-transformers
CONTINUUM_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CONTINUUM_MODEL_LOCAL_ONLY=true
CONTINUUM_CHROMA_URL=
CONTINUUM_EMBEDDING_URL=http://127.0.0.1:11434/api/embed
CONTINUUM_EMBEDDING_KEY=
CONTINUUM_ALLOW_REMOTE_PROCESSING=false
CONTINUUM_OLLAMA_URL=http://127.0.0.1:11434/api/chat
CONTINUUM_SUMMARY_MODEL=llama3.2
CONTINUUM_SUMMARY_PROVIDER=ollama
CONTINUUM_SUMMARY_URL=
CONTINUUM_SUMMARY_KEY=
CONTINUUM_RAW_CONVERSATION_RETENTION_DAYS=14
CONTINUUM_REDACT_AFTER_COMPACTION=false
