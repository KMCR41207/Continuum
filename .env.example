# Supabase publishable (or legacy anon) key only. Never use a service-role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_GOOGLE_AUTH_ENABLED=false
# Public application server URL only; leave blank until API is deployed.
VITE_API_URL=

# SERVER ONLY: use a private .env.server file, never VITE_ names for these secrets.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
APP_ORIGIN=http://localhost:5173
API_BIND=127.0.0.1
API_PORT=3101
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Configure approved price IDs and operational limits in plan_catalog.
EMBEDDING_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
# Database semantic vectors and provider dimensions are fixed at 384.
MCP_BIND=127.0.0.1
MCP_PORT=3100
MCP_ALLOWED_HOSTS=localhost:3100,127.0.0.1:3100
# HTTP MCP backend uses a public key, never the service-role credential.
CONTINUUM_SUPABASE_URL=
CONTINUUM_SUPABASE_KEY=
